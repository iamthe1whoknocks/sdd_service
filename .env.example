# Копируй в .env и меняй значения при необходимости.
# docker compose автоматически читает .env из текущего каталога.

# --- PostgreSQL ---
POSTGRES_USER=vulnrag
POSTGRES_PASSWORD=vulnrag
POSTGRES_DB=vulnrag

# --- Порты на хосте ---
WEB_PORT=8088
APP_PORT=8080
POSTGRES_PORT=5432
OLLAMA_PORT=11434

# --- Модели Ollama ---
# Эмбеддинги: размерность должна совпадать с vector(768) в миграции.
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
# LLM: компактная модель с хорошим русским (~2 ГБ, влезает в 16 ГБ RAM).
OLLAMA_LLM_MODEL=qwen2.5:3b